# Frontend Environment Variables
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=Kuwait English Learning Platform
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Authentication
VITE_JWT_SECRET=your_jwt_secret_key
VITE_SESSION_TIMEOUT=3600000

# Third-party Services
VITE_SPEECH_API_KEY=your_speech_api_key
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Feature Flags
VITE_ENABLE_SPEECH_RECOGNITION=true
VITE_ENABLE_PRONUNCIATION_ASSESSMENT=true
VITE_ENABLE_CULTURAL_CONTENT=true
VITE_ENABLE_PROGRESS_ANALYTICS=true

# Analytics
VITE_GOOGLE_ANALYTICS_ID=your_ga_id
VITE_ENABLE_ANALYTICS=true
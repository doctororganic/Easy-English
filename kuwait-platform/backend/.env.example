# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database
MONGODB_URI=mongodb://localhost:27017/kuwait_platform
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=30d

# Email Service (for notifications)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@kuwait-platform.com

# File Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_FILE_SIZE=10485760

# AI Services
OPENAI_API_KEY=your_openai_api_key
SPEECH_API_KEY=your_speech_api_key
SPEECH_API_SECRET=your_speech_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# External APIs
KUWAIT_EDUCATION_API_URL=https://api.kuwait-education.gov.kw
KUWAIT_CULTURE_API_URL=https://api.culture.gov.kw

# Feature Flags
ENABLE_SPEECH_RECOGNITION=true
ENABLE_PRONUNCIATION_ASSESSMENT=true
ENABLE_CULTURAL_CONTENT=true
ENABLE_PROGRESS_ANALYTICS=true
ENABLE_AI_CONTENT_GENERATION=true

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here
COOKIE_SECURE=false

# Development
DEBUG=kuwait-platform:*
MOCK_AI_SERVICES=false
SEED_DATABASE=true